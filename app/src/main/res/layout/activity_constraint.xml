<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvLab1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="60dp"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center"
        android:paddingTop="60dp"
        android:paddingBottom="60dp"
        android:text="Responsive Layout 1"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLab1" />

    <TextView
        android:id="@+id/boxThis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF0000"
        android:gravity="center"
        android:text="This"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvAndroidApp"
        app:layout_constraintEnd_toStartOf="@id/boxIs"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintVertical_weight="2.5" />

    <TextView
        android:id="@+id/boxIs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0000FF"
        android:gravity="center"
        android:text="is"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/boxThis"
        app:layout_constraintEnd_toStartOf="@id/boxMy"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/boxThis"
        app:layout_constraintTop_toTopOf="@id/boxThis" />

    <TextView
        android:id="@+id/boxMy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#673AB7"
        android:gravity="center"
        android:text="my"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/boxThis"
        app:layout_constraintEnd_toStartOf="@id/boxFirst"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/boxIs"
        app:layout_constraintTop_toTopOf="@id/boxThis" />

    <TextView
        android:id="@+id/boxFirst"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFF00"
        android:gravity="center"
        android:text="first"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/boxThis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/boxMy"
        app:layout_constraintTop_toTopOf="@id/boxThis" />

    <TextView
        android:id="@+id/tvAndroidApp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:gravity="center"
        android:text="Android Application"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/btnChangeMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boxThis"
        app:layout_constraintVertical_weight="2.5" />

    <Button
        android:id="@+id/btnChangeMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="15dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:text="Change"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancelMain"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAndroidApp"
        app:layout_constraintVertical_weight="2.5" />

    <Button
        android:id="@+id/btnCancelMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="30dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:text="Cancel"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/btnChangeMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnChangeMain"
        app:layout_constraintTop_toTopOf="@id/btnChangeMain" />

</androidx.constraintlayout.widget.ConstraintLayout>